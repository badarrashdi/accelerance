# Resend API Key (Create at https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Recipient email address where contact form inquiries are sent
# (Can be multiple comma-separated emails, e.g. sales@accelerance.in, admin@accelerance.in)
CONTACT_EMAIL_TO=sales@accelerance.in

# Sender email address
# For development/testing: onboarding@resend.dev (Resend default sandbox)
# For production: e.g. Accelerance Inquiries <sales@accelerance.in> (requires domain verification in Resend)
RESEND_FROM_EMAIL=Accelerance Inquiries <onboarding@resend.dev>
